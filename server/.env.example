PORT=4000

# MongoDB connection string (required). The app uses the "ai-image" database.
MONGODB_URI=your_mongodb_connection_string

# Long random string used to sign login tokens (required).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Clipdrop text-to-image API key (required)
CLIPDROP_API=your_clipdrop_api_key

# Payments (only needed to test buying credits)
CURRENCY=INR
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_SECRET_KEY=your_stripe_secret_key

# URL(s) of the deployed client, comma separated. Used for CORS and the
# Stripe redirect. Leave empty for local development.
# Example: https://your-app.vercel.app
CLIENT_URL=
